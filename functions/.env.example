# ==========================================
# Team Parlay Manager: Backend Configuration
# ==========================================

# 1. Kalshi Trade API v2 Configuration
# Public market discovery (NFL game lines & player props) requires NO API key.
# Optional: Provide your Key ID and path to your downloaded RSA private key file (.key / .pem)
# to enable live Multivariate/Combo RFQ quotes.
KALSHI_API_BASE_URL="https://api.elections.kalshi.com/trade-api/v2"
KALSHI_API_KEY_ID=""
KALSHI_PRIVATE_KEY_PATH="./kalshi_private_key.key"

# 2. macOS Local Emulator Compatibility (prevents Gunicorn fork Objective-C crash)
OBJC_DISABLE_INITIALIZE_FORK_SAFETY="YES"
NO_PROXY="*"

# 3. Maximum Leg Odds Limit
# Maximum probability limit for any single parlay leg in percentage (e.g. 55 for 55% / 55c)
# If left blank or unset, no maximum limit is enforced (100% allowed).
MAX_LEG_ODDS_PERCENT=55
