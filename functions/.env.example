# ==========================================
# Team Parlay Manager: Backend Configuration
# ==========================================

# 1. Sleeper League Configuration
# Find this in your Sleeper URL: https://sleeper.com/leagues/<SLEEPER_LEAGUE_ID>
SLEEPER_LEAGUE_ID="your_sleeper_league_id_here"
SLEEPER_SEASON="2026"

# 2. The Odds API (Free Tier)
# Get a free key at https://the-odds-api.com (500 requests/month, no credit card required)
ODDS_API_KEY="your_the_odds_api_key_here"

# 3. Security Salt
# Any secret random string used to salt PIN hashes on the server
PIN_SECRET_SALT="change_this_to_a_random_secret_salt_string"
